# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your own values:
#     Windows PowerShell:  copy .env.example .env
#     macOS / Linux:       cp .env.example .env
# `.env` is gitignored and must never be committed or shared.
# Write values directly after "=", with no quotes and no spaces.
# ---------------------------------------------------------------------------

# ===== Language models (required for the agents you use) =====
# Claude: https://platform.claude.com -> Settings -> API keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Kimi (Moonshot, international platform): https://platform.kimi.ai -> API keys
MOONSHOT_API_KEY=

# ===== Tracing (optional) =====
# Set LANGSMITH_TRACING=true to trace every model call in LangSmith.
# Traces contain prompts and paper text: keep the project private.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lit-review-agents
# Only if your organisation uses a non-default LangSmith region:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== Literature APIs (optional, recommended for rate limits) =====
# PubMed + PubTator3: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Semantic Scholar
S2_API_KEY=
# Your email, for the OpenAlex, Unpaywall and Crossref "polite pools"
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
# Only if you have an OpenAlex premium key
OPENALEX_API_KEY=

# ===== DrugBank (optional, licensed) =====
# Only if you have a DrugBank API licence; also set drugbank enabled: true in config/sources.yaml
DRUGBANK_API_KEY=

# ===== Email notification (SMTP) =====
# Gmail: turn on 2-step verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
