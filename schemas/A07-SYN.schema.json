{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A07-SYN output (top-level contract; see the prompt's output schema for full detail)",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "NEEDS_HUMAN_INPUT",
        "ABSTAINED",
        "FAILED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package_version": {
      "type": "string"
    },
    "fivew1h": {
      "type": "array"
    },
    "propositions": {
      "type": "array"
    },
    "groups": {
      "type": "array"
    },
    "knowledge_gaps": {
      "type": "array"
    },
    "proposed_interpretations": {
      "type": "array"
    },
    "thesis_options": {
      "type": "array"
    },
    "coverage_realization": {
      "type": "array"
    },
    "researcher_decision": {
      "type": "object"
    }
  },
  "required": [
    "agent_id",
    "prompt_version",
    "status",
    "warnings",
    "limitations",
    "package_version",
    "fivew1h",
    "propositions",
    "groups",
    "knowledge_gaps",
    "proposed_interpretations",
    "thesis_options",
    "coverage_realization",
    "researcher_decision"
  ],
  "additionalProperties": true
}
