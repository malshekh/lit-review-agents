{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A07-SYN job turn: PLAN (see the prompt's \u00a712 for full detail)",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "NEEDS_HUMAN_INPUT",
        "ABSTAINED",
        "FAILED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string"
    },
    "fivew1h": {
      "type": "array"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "kind",
          "name",
          "basis",
          "finding_ids"
        ]
      }
    },
    "findings_not_used": {
      "type": "array"
    }
  },
  "required": [
    "agent_id",
    "prompt_version",
    "status",
    "warnings",
    "limitations",
    "mode",
    "fivew1h",
    "groups",
    "findings_not_used"
  ],
  "additionalProperties": true
}
