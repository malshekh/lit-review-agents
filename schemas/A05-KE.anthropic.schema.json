          "attributed_to",
          "subthemes",
          "emerging",
          "emerging_note",
          "knowledge_assist"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "predicate": {
                  "const": "OTHER_SPECIFIED"
                }
              },
              "required": [
                "predicate"
              ]
            },
            "then": {
              "required": [
                "predicate_detail"
              ],
              "properties": {
                "predicate_detail": {
                  "type": "string",
                  "minLength": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "predicate": {
                  "not": {
                    "enum": [
                      "HALF_LIFE",
                      "MAXIMUM_TOLERATED_DOSE",
                      "OBSERVED_OUTCOME",
                      "TOLERATED"
                    ]
                  }
                }
              },
              "required": [
                "predicate"
              ]
            },
            "then": {
              "required": [
                "object_entity_id"
              ],
              "properties": {
                "object_entity_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
