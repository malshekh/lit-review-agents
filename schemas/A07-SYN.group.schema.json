{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A07-SYN job turn: GROUP (see the prompt's \u00a712 for full detail)",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "NEEDS_HUMAN_INPUT",
        "ABSTAINED",
        "FAILED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string"
    },
    "propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposition_id",
          "type",
          "assertion",
          "satisfies"
        ]
      }
    },
    "context_contrasts": {
      "type": "array"
    },
    "findings_context": {
      "type": "array"
    },
    "findings_not_used": {
      "type": "array"
    }
  },
  "required": [
    "agent_id",
    "prompt_version",
    "status",
    "warnings",
    "limitations",
    "mode",
    "propositions",
    "context_contrasts",
    "findings_context",
    "findings_not_used"
  ],
  "additionalProperties": true
}
