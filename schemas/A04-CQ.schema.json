{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A04-CQ output (top-level contract; see the prompt's output schema for full detail)",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "NEEDS_HUMAN_INPUT",
        "ABSTAINED",
        "FAILED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "batch_id": {
      "type": "string"
    },
    "received_record_ids": {
      "type": "array"
    },
    "qualifications": {
      "type": "array"
    },
    "human_review_queue": {
      "type": "array"
    },
    "theme_suggestions": {
      "type": "array"
    },
    "criteria_defects": {
      "type": "array"
    }
  },
  "required": [
    "agent_id",
    "prompt_version",
    "status",
    "warnings",
    "limitations",
    "batch_id",
    "received_record_ids",
    "qualifications",
    "human_review_queue",
    "theme_suggestions",
    "criteria_defects"
  ],
  "additionalProperties": true
}
