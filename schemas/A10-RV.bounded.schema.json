{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["agent_id","prompt_version","mode","status","verdicts","issues","retrieval_requests","inventory_fingerprint","reviewed_index_ids"],
  "properties":{
    "agent_id":{"const":"A10-RV"},"prompt_version":{"const":"2.0"},
    "mode":{"enum":["LOCAL","GLOBAL"]},"status":{"enum":["COMPLETE","NEEDS_EVIDENCE"]},
    "inventory_fingerprint":{"type":"string","maxLength":64},
    "reviewed_index_ids":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"type":"string","maxLength":160}},
    "verdicts":{"type":"array","maxItems":12,"items":{
      "type":"object","additionalProperties":false,
      "required":["occurrence_id","verdict","rationale","checks","appraisal_checks","evidence_finding_ids","source_item_ids"],
      "properties":{
        "occurrence_id":{"type":"string","maxLength":80},
        "verdict":{"enum":["VERIFIED","DEFECT","UNRESOLVED","NON_SCIENTIFIC"]},
        "rationale":{"type":"string","minLength":1,"maxLength":240},
        "checks":{"type":"array","maxItems":10,"uniqueItems":true,"items":{"enum":["SOURCE","NUMBERS_UNITS","MECHANISM_CAUSALITY","CERTAINTY","CHEMICAL_IDENTITY","MODEL_GBM","CLINICAL_REACH","COUNTER_EVIDENCE","ATTRIBUTION_INDEPENDENCE","CITATION"]}},
        "evidence_finding_ids":{"type":"array","uniqueItems":true,"maxItems":24,"items":{"type":"string","maxLength":120}},
        "source_item_ids":{"type":"array","uniqueItems":true,"maxItems":16,"items":{"type":"string","maxLength":120}},
        "appraisal_checks":{"type":"array","maxItems":24,"items":{"type":"object","additionalProperties":false,"required":["binding_id","preserved"],"properties":{"binding_id":{"type":"string","maxLength":240},"preserved":{"type":"boolean"}}}}
      }
    }},
    "issues":{"type":"array","maxItems":24,"items":{
      "type":"object","additionalProperties":false,
      "required":["occurrence_ids","finding_ids","code","severity","rationale","correction"],
      "properties":{
        "occurrence_ids":{"type":"array","minItems":1,"maxItems":24,"uniqueItems":true,"items":{"type":"string","maxLength":80}},
        "finding_ids":{"type":"array","maxItems":24,"uniqueItems":true,"items":{"type":"string","maxLength":120}},
        "code":{"type":"string","minLength":1,"maxLength":80},"severity":{"enum":["MINOR","MAJOR","BLOCKING"]},
        "rationale":{"type":"string","minLength":1,"maxLength":240},"correction":{"type":"string","minLength":1,"maxLength":360}
      }
    }},
    "retrieval_requests":{"type":"array","maxItems":4,"items":{
      "type":"object","additionalProperties":false,"minProperties":1,
      "properties":{
        "finding_ids":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":120}},
        "query":{"type":"string","minLength":1,"maxLength":160},
        "source_item_ids":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":120}},
        "proposition_ids":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":160}}
      }
    }}
  }
}
